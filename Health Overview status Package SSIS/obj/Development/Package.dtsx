                <property
                  dataType="System.String"
                  description="Commande SQL à exécuter."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT [ID_SEX],[ID_AGE_CATEGORY],[ID_B],[ID_STATE],PhysicalHealthDays, MentalHealthDays
FROM     
[COVID_19].[dbo].[BODY VITAL STATISTICS ],[COVID_19].[dbo].[GENDER],[COVID_19].[dbo].[STATE],[COVID_19].[dbo].[AGE],General_Health
Where [COVID_19].[dbo].[GENDER].[Sex]=[HealthCare].[dbo].[General_Health].[Sex]
and [COVID_19].[dbo].[STATE].[State]=[HealthCare].[dbo].[General_Health].[State]
and [COVID_19].[dbo].[AGE].[AgeCategory]=[HealthCare].[dbo].[General_Health].[AgeCategory]
and [COVID_19].[dbo].[BODY VITAL STATISTICS ].[PhysicalActivities]=[HealthCare].[dbo].[General_Health].[PhysicalActivities]
and [COVID_19].[dbo].[BODY VITAL STATISTICS ].[SleepHours]=[HealthCare].[dbo].[General_Health].[SleepHours]
AND [COVID_19].[dbo].[BODY VITAL STATISTICS ].[SmokerStatus]=[HealthCare].[dbo].[General_Health].[SmokerStatus]
AND [COVID_19].[dbo].[BODY VITAL STATISTICS ].[BMI]=[HealthCare].[dbo].[General_Health].[BMI]
AND [COVID_19].[dbo].[BODY VITAL STATISTICS ].[WeightInKilograms]=[HealthCare].[dbo].[General_Health].[WeightInKilograms]
AND [COVID_19].[dbo].[BODY VITAL STATISTICS ].[HeightInMeters]=[HealthCare].[dbo].[General_Health].[HeightInMeters]</property>
